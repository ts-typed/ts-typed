{
    "name": "@ts-typed/core",
    "version": "0.2.0",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "description": "Runtime protection for TypeScript contracts",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=18"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "ts-typed": "dist/cli/index.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./integration": {
            "types": "./dist/integration/index.d.ts",
            "require": "./dist/integration/index.js",
            "default": "./dist/integration/index.js"
        },
        "./config": {
            "types": "./dist/config/index.d.ts",
            "require": "./dist/config/index.js",
            "default": "./dist/config/index.js"
        },
        "./schema.json": "./schema.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "scripts",
        "schema.json",
        "LICENSE",
        "NOTICE",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "tsc",
        "test": "npm run build && node --expose-gc --test --test-concurrency=1",
        "postinstall": "node scripts/postinstall.cjs"
    },
    "dependencies": {
        "@vercel/ncc": "0.38.4"
    },
    "peerDependencies": {
        "typescript": ">=5.4 <7"
    },
    "devDependencies": {
        "@types/node": "^22.15.21",
        "typescript": "5.9.3"
    }
}
